{
  "name": "cachegrid-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CacheGrid backend workspace",
  "type": "module",
  "workspaces": [
    "common-library",
    "cache-node",
    "gateway-service"
  ],
  "scripts": {
    "start": "npm --workspace cache-node run start",
    "start:cache": "npm --workspace cache-node run start",
    "start:gateway": "npm --workspace gateway-service run start",
    "dev": "npm --workspace cache-node run dev",
    "dev:gateway": "npm --workspace gateway-service run dev",
    "test": "npm test --workspaces --if-present",
    "test:cache": "npm --workspace cache-node test",
    "test:gateway": "npm --workspace gateway-service test"
  },
  "engines": {
    "node": ">=22"
  }
}
